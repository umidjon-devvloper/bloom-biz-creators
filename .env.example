# Copy to .env and fill in. .env is gitignored — never commit real values.

MONGODB_URI=mongodb://localhost:27017/umidjon-agency

# Lead notifications to Telegram.
# TELEGRAM_BOT_TOKEN — from @BotFather.
# TELEGRAM_CHAT_ID   — the chat that receives leads. Press Start in the bot, then
#                      open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#                      result[0].message.chat.id (a group id starts with -100).
# Leaving either blank disables notifications; leads are still saved to the DB.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lead notifications through the standalone bot service (./bot-server).
# When LEAD_BOT_URL is set the site forwards leads there instead of calling
# Telegram itself, and the two TELEGRAM_* values above are not needed here —
# they live in bot-server/.env. LEAD_BOT_API_KEY must match the service's
# LEAD_API_KEY.
LEAD_BOT_URL=
LEAD_BOT_API_KEY=
